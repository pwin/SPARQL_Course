# Build output and derived stores -----------------------------------------
build/
run/
derby.log

# Third-party binaries. None of these are ours to redistribute, and two of
# them must not be redistributed at all, so they are fetched by the setup
# scripts instead of being committed.
#
#   lib/geosparql/sis-epsg-*.jar        the EPSG geodetic dataset. Published
#                                       by IOGP under terms that require the
#                                       user to accept them; Apache ships it
#                                       under the groupId "non-free" for
#                                       exactly this reason. Fetched by
#                                       scripts/setup-geosparql.ps1
#                                       -AcceptEpsgTerms.
#   build/sis-data/                     the database SIS builds FROM that
#                                       dataset. Same restriction.
#   lib/geosparql/org.apache.derby.*    Apache Derby, Apache-2.0. Freely
#                                       redistributable, but an 4 MB binary
#                                       has no business in a source repo.
#   lib/owl/robot.jar                   ROBOT, BSD-3-Clause. 82 MB, likewise.
lib/

# Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
