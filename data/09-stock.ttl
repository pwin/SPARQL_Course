############################################################################
#  09  STOCK, THE RDF 1.1 WAY
############################################################################
#  Ninety-five stock records. Each says how many copies a shop holds and
#  at what price -- facts about a relationship, not about a thing. RDF
#  1.1 has to invent a node to hang them on. File 10 says the same thing
#  in RDF 1.2 with no invented node at all; comparing the two is the
#  whole point of the SPARQL 1.2 module.
#
bt:stock-inkwell--the-book-town
    a              bs:StockRecord ;
    bs:atShop      bt:shop-inkwell ;
    bs:ofWork      bt:book-the-book-town ;
    bs:copies      "12"^^xsd:integer ;
    bs:shelfPrice  "9.99"^^xsd:decimal .

