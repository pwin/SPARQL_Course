#
#  ==== 05-people.ttl ===============================================
#


############################################################################
#  05  AUTHORS AND PUBLISHERS
############################################################################
#  The influence graph is a directed graph with long chains, a diamond,
#  and one mutual pair -- because a learner has to discover that
#  bs:influencedBy+ copes with a cycle and a hand-rolled recursive join
#  does not. Publisher imprints nest three deep.
#

# ------------------------------------------------------------------------
# Publishers
# ------------------------------------------------------------------------
bt:pub-lodestone-group
    a             bs:Publisher ;
    rdfs:label    "Lodestone Group"@en ;
    bs:founded    "1988"^^xsd:gYear ;
    bs:locatedIn  bt:place-london .

bt:pub-northwind
    a             bs:Publisher ;
    rdfs:label    "Northwind Press"@en ;
    bs:imprintOf  bt:pub-lodestone-group ;
    bs:founded    "1971"^^xsd:gYear ;
    bs:locatedIn  bt:place-edinburgh .

bt:pub-saltmarsh
    a             bs:Publisher ;
    rdfs:label    "Saltmarsh Books"@en ;
    bs:imprintOf  bt:pub-northwind ;
    bs:founded    "1996"^^xsd:gYear ;
    bs:locatedIn  bt:place-norwich .

