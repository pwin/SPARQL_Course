# Settlements
# ------------------------------------------------------------------------
bt:place-wigtown
    a                       bs:Settlement, bs:Place, geo:Feature ;
    rdfs:label              "Wigtown"@en ;
    rdfs:label              "Baile na h-Uige"@gd ;
    owl:sameAs              <http://dbpedia.org/resource/Wigtown> ;
    bs:within               bt:place-dumfries-galloway ;
    bs:population           "1000"^^xsd:integer ;
    bs:isBookTown           true ;
    wgs84:lat               "54.869"^^xsd:decimal ;
    wgs84:long              "-4.44"^^xsd:decimal ;
    geo:hasGeometry         bt:geom-wigtown ;
    geo:hasDefaultGeometry  bt:geom-wigtown .

bt:geom-wigtown
    a          sf:Point, geo:Geometry ;
    geo:asWKT  "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-4.44000 54.86900)"^^geo:wktLiteral .

