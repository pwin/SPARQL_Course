############################################################################
#  08  THE TRAIL
############################################################################
#  Thirty-three segments joining the shops. Mostly linear, with two
#  branches and one loop -- and one pair of shops in the south west that
#  connects to nothing else. bs:connectsTo+ therefore returns a strictly
#  smaller set than 'every shop', which is the point.
#
bt:seg-inkwell-marginalia
    a                       bs:TrailSegment, geo:Feature ;
    rdfs:label              "The Inkwell to Marginalia"@en ;
    bs:segmentFrom          bt:shop-inkwell ;
    bs:segmentTo            bt:shop-marginalia ;
    bs:distanceKm           "0.3"^^xsd:decimal ;
    bs:waymarked            true ;
    geo:hasGeometry         bt:geom-seg-inkwell-marginalia ;
    geo:hasDefaultGeometry  bt:geom-seg-inkwell-marginalia .

bt:geom-seg-inkwell-marginalia
    a          sf:LineString, geo:Geometry ;
    geo:asWKT  "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> LINESTRING(-4.43821 54.87061, -4.45249 54.85650, -4.44087 54.87287)"^^geo:wktLiteral .

bt:shop-inkwell
    bs:connectsTo  bt:shop-marginalia .

