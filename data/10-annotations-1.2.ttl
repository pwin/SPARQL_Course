# ------------------------------------------------------------------------
# Triple terms in object position -- a source pointing at a statement it rejects
# ------------------------------------------------------------------------
bt:source-national-register
    bs:disputes  <<( bt:shop-ex-libris bs:founded "1921"^^xsd:gYear )>> .

bt:source-county-survey
    bs:disputes  <<( bt:shop-candlemas bs:founded "1928"^^xsd:gYear )>> .

bt:source-trail-guide-2024
    bs:disputes  <<( bt:shop-castle-steps bs:founded "1965"^^xsd:gYear )>> .


# ------------------------------------------------------------------------
# Language with a base direction
# ------------------------------------------------------------------------
# Every translation label in file 06 already carries a direction where
# the script needs one.  These are the shop notices in the same
# languages, so hasLANGDIR has more than six rows to work with.

bt:shop-verso
    skos:note  "Translated fiction from twenty languages"@en .

bt:shop-verso
    skos:note  "خيال مترجم من عشرين لغة"@ar--rtl .

