# ------------------------------------------------------------------------
# Disputed founding dates -- two sources, one shop, different answers
# ------------------------------------------------------------------------
bt:shop-ex-libris bs:founded "1919"^^xsd:gYear
    {| bs:claimedBy bt:source-national-register ;
       bs:confidence "0.99"^^xsd:decimal |} .

bt:shop-ex-libris bs:founded "1921"^^xsd:gYear
    {| bs:claimedBy bt:source-local-paper ;
       bs:confidence "0.40"^^xsd:decimal |} .

bt:shop-endpapers bs:founded "1949"^^xsd:gYear
    {| bs:claimedBy bt:source-national-register ;
       bs:confidence "0.97"^^xsd:decimal |} .

