    {| bs:claimedBy bt:source-trail-guide-2024 ;
       bs:confidence "0.85"^^xsd:decimal |} .

bt:shop-castle-steps bs:founded "1965"^^xsd:gYear
    {| bs:claimedBy bt:source-trail-guide-2019 ;
       bs:confidence "0.45"^^xsd:decimal |} .


