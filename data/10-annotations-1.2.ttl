    {| bs:claimedBy bt:source-local-paper ;
       bs:confidence "0.35"^^xsd:decimal |} .

bt:shop-gutter-gilt bs:founded "1955"^^xsd:gYear
    {| bs:claimedBy bt:source-county-survey ;
       bs:confidence "0.92"^^xsd:decimal |} .

bt:shop-gutter-gilt bs:founded "1955"^^xsd:gYear
    {| bs:claimedBy bt:source-shop-website ;
       bs:confidence "0.80"^^xsd:decimal |} .

