############################################################################
#  04  BOOKSHOPS
############################################################################
#  Thirty-three invented shops in real towns. Every shop has a point
#  geometry a few hundred metres from the town centre, so two shops in
#  the same town are genuinely a short walk apart. Not every shop has a
#  website: that gap is what OPTIONAL is for.
#
bt:shop-inkwell
    a                       bs:Bookshop, geo:Feature ;
    rdfs:label              "The Inkwell"@en ;
    bs:locatedIn            bt:place-wigtown ;
    bs:founded              "1979"^^xsd:gYear ;
    bs:floorArea            "140.0"^^xsd:decimal ;
    bs:staffCount           "4"^^xsd:integer ;
    bs:specialises          bt:genre-crime-fiction ;
    bs:sellsSecondHand      true ;
    bs:hasCafe              true ;
    bs:website              "https://example.org/shops/inkwell"^^xsd:anyURI ;
    wgs84:lat               "54.87061"^^xsd:decimal ;
    wgs84:long              "-4.43821"^^xsd:decimal ;
    geo:hasGeometry         bt:geom-shop-inkwell ;
    geo:hasDefaultGeometry  bt:geom-shop-inkwell .

bt:geom-shop-inkwell
    a          sf:Point, geo:Geometry ;
    geo:asWKT  "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT(-4.43821 54.87061)"^^geo:wktLiteral .

