# ==========================================================================
#  Q11  Place names in Welsh and Gaelic
# ==========================================================================
#
#  ASKS
#    Which places carry a name in a language other than English?
#
#  HOW IT WORKS
#    A language-tagged literal carries its tag as part of the value. LANG()
#    extracts it; comparing it to '' finds the untagged ones. Here we keep
#    everything that's tagged but not English.
#
#  DIAGRAM
#        bt:place-cardiff rdfs:label "Cardiff"@en
#                         rdfs:label "Caerdydd"@cy
#                                     ───────  ──
#                                      value   tag
#
#        LANG(?label)  ──▶  "en"   or  "cy"   or  ""  (no tag at all)
#
#        FILTER( LANG(?label) != "en" && LANG(?label) != "" )
#
#        langMatches(LANG(?l), "cy") is the proper test: it also matches
#        "cy-GB", which a plain = would miss.
#
#
#  WHAT TO TAKE AWAY
#    - A language tag is part of the literal, not a separate property.
#    - LANG() returns the empty string for a literal with no tag, so a
#      bare != "en" would let untagged strings through.
#    - langMatches handles subtags such as cy-GB properly; use it when
#      the data may contain them.
#
#  DATA     bookshop-trail-1.1.ttl
#  LOAD IT  https://semantechs.co.uk/turtle-editor-viewer/?dot=https%3A%2F%2Fraw.githubusercontent.com%2Fpwin%2FSPARQL_Course%2Fmain%2Fdata%2Fbookshop-trail-1.1.ttl
#  RUNS ON  editor, holos, fuseki
#  RETURNS  10 rows, on every engine that runs it
# ==========================================================================

PREFIX bs:   <https://example.org/bookshop-trail/schema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?place ?label ?language
WHERE {
  ?place a          bs:Place ;
         rdfs:label ?label .
  BIND( LANG(?label) AS ?language )
  FILTER( ?language != "en" && ?language != "" )
}
ORDER BY ?language ?label
